# Reference shape of backend/.env on aiswe.uwb.edu, as verified on 2026-10-31.
# Secrets are placeholders. Keep the file at mode 600 (chmod 600 backend/.env):
# it holds DATABASE_URL and the worker token. Every other key and its default is
# documented in backend/.env.example; only what production sets, or should set,
# is listed here. The backend loads this file itself and the systemd unit also
# passes it as EnvironmentFile, so the two agree by construction.

# Base model, embeddings and starter calls: the main Ollama on :11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
STARTER_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60
STARTER_OLLAMA_TIMEOUT_SECONDS=300
# Must be present: the code default is true when the key is absent, and a
# starter seed job holds the only generation slot for minutes.
AUTO_STARTER_SEED_GENERATION=false

# Fine-tuned conditions: the VM-local aiswe-finetuned unit
# (`scripts/aiswe_finetuned.sh install` writes this; the Tillicum fallback
# tunnel writes the same value while it owns the port).
FINETUNED_SERVICE_URL=http://127.0.0.1:9001
FINETUNED_SERVICE_TIMEOUT_SECONDS=120

# Generation queue. These are the code defaults, written out so the contract
# with Nginx's proxy_read_timeout 300 is visible: 150 s queued + 120 s generating.
GENERATION_MAX_CONCURRENCY=1
GENERATION_MAX_WAITING=160
GENERATION_QUEUE_TIMEOUT_SECONDS=150

# Classroom preparation and the answer cache (docs/classroom-preparation.md).
# Off unless ANSWER_CACHE_ENABLED is true; leave it unset until the feature
# has been verified on this VM. The other three are the code defaults.
# ANSWER_CACHE_ENABLED=true
# CLASSROOM_PREP_QUIET_SECONDS=120
# CLASSROOM_PREP_STOP_GRACE_SECONDS=180
# CLASSROOM_PREP_BATCH_SIZE=1

# Origins. CORS_ALLOWED_ORIGINS is the CORS list and, together with
# APP_PUBLIC_ORIGIN, the CSRF allow-list. (The 2026-10-31 inspection found the
# Vite development origins still listed here on the VM; harmless because
# APP_PUBLIC_ORIGIN covers the CSRF check, but the site origin is the right value.)
CORS_ALLOWED_ORIGINS=https://aiswe.uwb.edu
APP_PUBLIC_ORIGIN=https://aiswe.uwb.edu

# Secrets.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>
# openssl rand -hex 32; the same value goes in .env.local on Tillicum.
TRAINING_WORKER_TOKEN=<worker token>

# CSS 360 research benchmark: off unless all three are set
# (docs/css360-benchmark-endpoint.md; `backend/scripts/css360_benchmark_env.py --enable`).
CSS360_BENCHMARK_ENABLED=false
# CSS360_BENCHMARK_TOKEN=<benchmark token>
# CSS360_BENCHMARK_SERVICE_URL=http://127.0.0.1:9002
