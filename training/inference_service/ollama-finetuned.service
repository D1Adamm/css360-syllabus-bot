# A second Ollama server, on loopback :11435, for the per-course fine-tuned
# models only. The base model (Base, RAG) and the embedding model stay on the
# VM's main Ollama (:11434).
#
# Why a second server: every course model is `FROM llama3.2:3b` + `ADAPTER`,
# so it has the same weights file as the base model, and one Ollama keeps at
# most one loaded runner per weights file. On a single server, each switch
# between a Base/RAG request and a Fine-Tuned request unloads one model and
# loads the other; in a class that is nearly every request. Two servers have
# two schedulers, so both models stay resident. Both read the same model
# store, so nothing is copied and `ollama create` on the main server is seen
# here at once. See docs/classroom-capacity.md.
#
# A SYSTEM unit, like the main `ollama.service`, run as the same user so it can
# read the same store. Before installing, compare with `systemctl cat ollama`
# and make ExecStart, User, Group and OLLAMA_MODELS match it:
#   sudo cp training/inference_service/ollama-finetuned.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ollama-finetuned
# Then point the fine-tuned service at it (OLLAMA_BASE_URL in
# ~/.config/aiswe/finetuned.env) and restart that: see the doc.
[Unit]
Description=Ollama for per-course fine-tuned models (loopback :11435)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Environment="OLLAMA_HOST=127.0.0.1:11435"
# The main server's store. Must match its OLLAMA_MODELS (the packaged
# default for a system install is shown).
Environment="OLLAMA_MODELS=/usr/share/ollama/.ollama/models"
# This server never creates or deletes models; it must not prune blobs the
# main server's models use either.
Environment="OLLAMA_NOPRUNE=1"
# Course models share one weights file, so this server can only ever hold one
# of them; say so explicitly rather than rely on the default of three.
Environment="OLLAMA_MAX_LOADED_MODELS=1"
# One sequence per runner, as on the main server. Raise only together with
# FINETUNED_MAX_CONCURRENCY and GENERATION_MAX_CONCURRENCY, after measuring.
Environment="OLLAMA_NUM_PARALLEL=1"
# A request without its own keep_alive keeps the model this long. The
# fine-tuned service sends FINETUNED_KEEP_ALIVE on every request anyway.
Environment="OLLAMA_KEEP_ALIVE=30m"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
