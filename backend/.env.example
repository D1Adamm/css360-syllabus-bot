# Copy to backend/.env for local development.
# uvicorn loads this file automatically via python-dotenv.

# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60

# Starter seed generation: shared budget for generation + validation Ollama calls
STARTER_MAX_TOTAL_OLLAMA_CALLS=80

# Automatic starter seeds after syllabus indexing (0 disables auto-queue)
STARTER_AUTO_GENERATE_COUNT=50

# Firebase Realtime Database (backend seed persistence only)
FIREBASE_DATABASE_URL=
# FIREBASE_AUTH_TOKEN=

# Local frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
