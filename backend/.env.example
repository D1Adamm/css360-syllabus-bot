# Copy to backend/.env for local development.
# uvicorn loads this file automatically via python-dotenv.

# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
STARTER_EMBED_MODEL=nomic-embed-text
SEED_GENERATION_MODEL=qwen3:8b
# Fact extraction only; defaults to SEED_GENERATION_MODEL when unset.
# Extraction copies facts out of the syllabus rather than writing new text, so a
# smaller model is often as good and is much faster on a CPU host, where starter
# calls run one at a time.
# STARTER_INVENTORY_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=60

# Fine-tuned inference service: the per-course /health + /generate contract.
# On aiswe.uwb.edu this is the local Ollama-backed service
# (training/inference_service/ollama_service.py), which listens on
#   FINETUNED_SERVICE_URL=http://127.0.0.1:9001
# and needs no Tillicum session or SSH tunnel. The Tillicum GPU service is the
# fallback; its tunnel helper sets the same URL, so never run both at once.
# Do not hardcode a Tillicum compute hostname (it changes every Slurm job).
FINETUNED_SERVICE_URL=
FINETUNED_SERVICE_TIMEOUT_SECONDS=120
# Read by the local Ollama-backed service, not by the backend. One entry per
# course and version, courseId@vN=ollamaModel, comma separated:
#   FINETUNED_OLLAMA_MODELS=css-360-winter-2026-a7rp@v2=css360-ft-v2:latest

# CSS 360 controlled benchmark (research only; see docs/css360-benchmark-endpoint.md).
# POST /api/research/css360/benchmark/{pair,standalone} answer 404 unless all
# three are set: the flag, a bearer token of at least 32 characters, and the
# URL of the benchmark-only inference service
# (training/inference_service/benchmark_service.py, loopback :9002). The token
# is a separate credential from every session cookie and from
# TRAINING_WORKER_TOKEN; it reaches these two routes and nothing else.
# Set all three with `.venv/bin/python scripts/css360_benchmark_env.py --enable`
# (idempotent; generates and keeps the token) and turn off with `--disable`.
# CSS360_BENCHMARK_ENABLED=false
# CSS360_BENCHMARK_TOKEN=
# CSS360_BENCHMARK_SERVICE_URL=http://127.0.0.1:9002
# Optional limits (bounded in code): per-condition timeout 1-600 s, default 120;
# concurrent requests 1-4, default 1; accepted requests per client per minute
# 1-600, default 30.
# CSS360_BENCHMARK_CONDITION_TIMEOUT_SECONDS=120
# CSS360_BENCHMARK_MAX_CONCURRENT=1
# CSS360_BENCHMARK_REQUESTS_PER_MINUTE=30
# Read by the benchmark service, not by the backend: alias=ollamaTag entries
# for the fixed aliases base, v2, v3, v4_vm, v4_tillicum. Nothing is mapped by
# default, and the production FINETUNED_OLLAMA_MODELS mapping is untouched.
#   CSS360_BENCHMARK_OLLAMA_MODELS=base=llama3.2:3b,v2=css360-ft-v2:latest,v3=css360-cpu-v3-test:latest,v4_vm=css360-v4-test:latest,v4_tillicum=css360-v4-tillicum-test:latest

# Starter seed generation: shared budget for planning + generation + validation
STARTER_MAX_TOTAL_OLLAMA_CALLS=140
# Longer timeout for starter planning/generation/validation (Base/RAG keep OLLAMA_TIMEOUT_SECONDS)
STARTER_OLLAMA_TIMEOUT_SECONDS=300
# Output-token caps for starter qwen3 calls only (Base/RAG omit num_predict)
# Inventory needs the largest of the three: one call returns every fact found in
# a batch of syllabus text, each with a verbatim evidence quote. Too low and the
# JSON is cut off mid-object, the batch is discarded, and the run quietly loses
# that part of the syllabus.
STARTER_INVENTORY_NUM_PREDICT=3072
STARTER_GENERATION_NUM_PREDICT=384
STARTER_VALIDATION_NUM_PREDICT=256

# Automatic starter seeds after syllabus indexing
# Set false to create/index courses without starting a long seed job.
# Manual POST /api/courses/{courseId}/seeds/generate-starter still works.
AUTO_STARTER_SEED_GENERATION=false
# Target count when auto-generation is enabled (0 also disables auto-queue)
STARTER_AUTO_GENERATE_COUNT=50

# PostgreSQL: the system of record for courses, seeds, evaluations, the model
# registry, model requests, and the training queue. Required — every
# persistence route and the starter-seed job read this.
# Example: postgresql://syllabus_bot@localhost:5432/syllabus_bot
DATABASE_URL=

# Shared secret the Tillicum training worker presents as X-Training-Worker-Token
# to reach /api/training-queue (claim a run, report submission/failure, register
# a finished model). Leave it unset and that router refuses every request with
# 503 rather than serving an unauthenticated queue — so it must be set before
# training can run. The same value goes in the worker's environment on Tillicum.
# Generate with: openssl rand -hex 32
TRAINING_WORKER_TOKEN=

# Which environment this process is. Leave unset or set to `production` on the
# VM; `test` turns on the barrier that stops this file being read at all;
# `development` additionally serves the interactive API docs at /docs, which
# are otherwise not mounted.
#
# That barrier exists because of a real incident: `env -u DATABASE_URL pytest`
# still reached the production database, since app.db reloaded this file
# precisely when DATABASE_URL was missing. Under APP_ENV=test — and, as a
# fallback, whenever pytest is imported — backend/.env is not read and
# DATABASE_URL is ignored outright. A deliberate integration suite supplies
# TEST_DATABASE_URL instead. See backend/tests/test_test_isolation.py.
# APP_ENV=production

# The only DSN a test process may connect to. Never set this on the VM.
# TEST_DATABASE_URL=postgresql://tester@localhost:5432/syllabus_bot_test

# Local frontend origins allowed by CORS. Also the allowlist for the CSRF
# origin check on cookie-authenticated mutations. Locally the Vite proxy makes
# development same-origin, so this only matters for a cross-origin setup; on
# the VM it is the site origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Authentication and sessions (app/auth/settings.py)
#
# Every value has a safe default and none is a secret: the secrets are the
# session and invitation tokens, which the tables store hashed. A production
# host behind Nginx and HTTPS needs to set nothing in this block.
# ---------------------------------------------------------------------------

# Session cookies are HttpOnly, SameSite=Lax, Path=/api, and carry `Secure`
# unless this is false. Set false only for local development over plain HTTP
# in a browser that refuses Secure cookies on http://localhost (Safari).
# AUTH_COOKIE_SECURE=true

# Professor/admin sessions: absolute lifetime and idle timeout.
# AUTH_STAFF_SESSION_MAX_DAYS=7
# AUTH_STAFF_SESSION_IDLE_HOURS=24

# Anonymous student sessions: absolute lifetime, no idle timeout.
# AUTH_PARTICIPANT_SESSION_DAYS=180

# Default lifetimes of single-use invitations (admins may shorten per link).
# AUTH_PROFESSOR_INVITE_DAYS=7
# AUTH_ADMIN_INVITE_HOURS=24
# AUTH_RESET_INVITE_HOURS=24

# The site origin, e.g. https://aiswe.uwb.edu. Optional: lets
# scripts/bootstrap_admin_invite.py print a complete link, and is accepted as
# a CSRF origin alongside CORS_ALLOWED_ORIGINS. The browser composes every
# link it shows from its own origin, so nothing else reads this.
# APP_PUBLIC_ORIGIN=https://aiswe.uwb.edu
