# Frontend build/runtime configuration.
# Copy to .env.local for local development.

# Where the browser reaches FastAPI.
#
# The `/api` suffix is REQUIRED. The frontend clients write paths *below* it —
# dbApi.ts composes `/db/courses`, api.ts composes `/courses/{id}/seeds` — and
# only the health and inference routes have root-level aliases on the backend.
# Without the suffix every persistence request 404s.
#
# Deployed, this is the site origin plus /api, e.g. https://aiswe.uwb.edu/api
VITE_API_BASE_URL=http://127.0.0.1:8001/api

# Tillicum training worker (scripts/lib/training_queue.py,
# training/run_training_queue.py, scripts/register_course_model.py).
# The worker reaches the queue over HTTPS; it never connects to PostgreSQL.
# TRAINING_API_BASE_URL=https://aiswe.uwb.edu
# Shared secret, must match TRAINING_WORKER_TOKEN in backend/.env.
# Generate with: openssl rand -hex 32
# TRAINING_WORKER_TOKEN=

# ---------------------------------------------------------------------------
# Tillicum only. None of these is a secret; the one secret on the cluster is
# TRAINING_WORKER_TOKEN above, which is read from this file rather than passed
# through the scheduler — start_qlora_training.sh scrubs it from the sbatch
# environment deliberately, so it never appears in a job's environment on a
# compute node.
# ---------------------------------------------------------------------------

# Where published per-course adapters live. The inference service resolves an
# adapter from <SERVING_ROOT>/<courseId>/<version>/adapter, so this is the one
# setting that decides which courses a serving session can answer for.
# SERVING_ROOT=/gpfs/projects/simswe/$USER/training_outputs/serving

# How many course adapters may be resident on the GPU at once. Adapters are
# ~47 MB against a ~2.5 GB 4-bit base, so this is a guard against a term with
# many courses rather than a tuning knob.
# MAX_LOADED_ADAPTERS=4

# Serving session length. The default is the most the configured QOS allows, so
# the ordinary command needs no flag at all:
#
#   ./training/start_finetuned_service.sh
#
# SERVICE_QOS selects the QOS and therefore the ceiling: `debug` (the default)
# caps a job at 1 hour; `normal` permits longer. A request over the ceiling is
# refused before sbatch — Slurm would otherwise accept it and leave the job
# PENDING forever with QOSMaxWallDurationPerJobLimit, which looks like a busy
# cluster rather than a request that can never be satisfied.
#
# SERVICE_QOS=debug
# SERVICE_HOURS=1          # defaults to the QOS ceiling
# SERVICE_MAX_HOURS=       # override the ceiling only if you know it differs

# Nodes to keep submissions off, for temporary infrastructure troubleshooting
# only. Empty by default, and nothing is remembered between runs — a node that
# fails its GPU preflight today is usually repaired within days, and Slurm has
# to stay free to schedule it.
# TRAINING_EXCLUDE_NODES=
# SERVICE_EXCLUDE_NODES=

# Training wall clock. By default it is computed from the dataset size — 30
# minutes of overhead plus 20 seconds per optimizer step, floored at 1 hour and
# capped at 8. Set QLORA_WALLTIME to override one submission outright, or
# QLORA_MAX_WALLTIME to raise the cap for a genuinely large course.
# QLORA_WALLTIME=02:00:00
# QLORA_MAX_WALLTIME=16:00:00

# Where versioned training runs are written. Read by
# training/cleanup_training_outputs.sh.
# TRAINING_OUTPUTS_ROOT=/gpfs/projects/simswe/$USER/training_outputs
