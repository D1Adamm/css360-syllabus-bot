# Mutable settings for the aiswe-finetuned user unit (VM-local fine-tuned
# inference). Installed to ~/.config/aiswe/finetuned.env with mode 600 by
# `./scripts/aiswe_finetuned.sh install`; edit the mapping with
# `./scripts/aiswe_finetuned.sh set-mapping <courseId> <vN> <ollamaTag>` rather
# than by hand, then `./scripts/aiswe_finetuned.sh restart`.
#
# systemd EnvironmentFile syntax: KEY=value, no shell expansion, `#` comments.
# Nothing in this file is a secret.

# One entry per course and version, courseId@vN=ollamaTag, comma separated.
# The version is the one PostgreSQL publishes for the course; the backend sends
# it with every request and a version this host does not map is refused.
# Nothing is mapped by default: with an empty value every fine-tuned request
# is a 409 and /health reports no servable course.
FINETUNED_OLLAMA_MODELS=

# How long Ollama keeps a fine-tuned model resident after a request. Ollama's
# default is five minutes, after which the next question pays the model load
# again (several seconds on this CPU host). 30m keeps a class warm.
FINETUNED_KEEP_ALIVE=30m

# The Ollama that serves the course models. In production this is the
# separate fine-tuned Ollama (training/inference_service/ollama-finetuned.service),
# so a course model and the base model are never swapped in and out of one
# server; see docs/classroom-capacity.md. Unset means the main Ollama on :11434.
# OLLAMA_BASE_URL=http://127.0.0.1:11435

# Generations this service sends Ollama at once. The backend's queue
# (GENERATION_MAX_CONCURRENCY) is the real bound; keep this at 1 unless
# OLLAMA_NUM_PARALLEL on the fine-tuned Ollama was raised too.
# FINETUNED_MAX_CONCURRENCY=1

# Optional. Defaults shown; see training/inference_service/README.md.
# FINETUNED_OLLAMA_TIMEOUT_SECONDS=120
# FINETUNED_NUM_CTX=4096
# FINETUNED_BASE_MODEL=llama3.2:3b
